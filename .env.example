# Server Configuration
# Azure App Service automatically injects PORT at runtime.
PORT=3000
NODE_ENV=development

# Storage Mode: "demo" (in-memory sample data) or "azure_sql" (Microsoft Azure SQL Database)
STORAGE_MODE=demo

# Microsoft Azure SQL Database Configuration (used when STORAGE_MODE=azure_sql)
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=hospital_management_db
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true

# Admin Authentication Configuration
# Optional: set an explicit admin email & passcode in Azure App Service Application Settings
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSCODE=
# Optional: signing secret for session tokens (auto-generated in memory if omitted)
SESSION_SECRET=
